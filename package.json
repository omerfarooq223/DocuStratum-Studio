{
  "name": "webrag-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "WebRAG Studio - local-first Chrome extension side panel and FastAPI service for DOM capture, block review, chunking comparison, local vector retrieval, and grounded RAG.",
  "scripts": {
    "check": "bash scripts/check-all.sh",
    "test": "bash scripts/check-all.sh",
    "build:extension": "cd extension && npm run build",
    "test:capture": "cd extension && npm test",
    "test:capture:live": "cd extension && npm run test:capture:live",
    "test:chunking": "cd extension && npm run test:chunking",
    "test:retrieval": "cd extension && npm run test:retrieval",
    "test:service": "cd service && python3 -m pytest",
    "smoke": "bash scripts/smoke-golden-path.sh",
    "smoke:golden-path": "bash scripts/smoke-golden-path.sh",
    "benchmark:retrieval": "HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONPATH=. .venv/bin/python scripts/benchmark-retrieval.py"
  },
  "keywords": [
    "rag",
    "chrome-extension",
    "fastapi",
    "embeddings",
    "retrieval",
    "vector-search"
  ],
  "author": "WebRAG Developer",
  "license": "MIT"
}
