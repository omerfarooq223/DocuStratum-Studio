{
  "name": "docustratum-studio-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:chunking": "vitest run src/chunking/__tests__/chunking.test.ts src/sidepanel/__tests__/chunk-comparison.test.tsx src/sidepanel/__tests__/sidepanel.test.tsx",
    "test:retrieval": "vitest run src/sidepanel/__tests__/retrieval.test.tsx",
    "test:capture:live": "WEBRAG_LIVE_TEST=1 vitest run src/capture/__tests__/capture.live.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.0.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
