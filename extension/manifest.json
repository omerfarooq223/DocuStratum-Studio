{
  "manifest_version": 3,
  "name": "WebRAG Studio",
  "version": "0.1.0",
  "description": "Capture DOM structures, compare chunking strategies, inspect vector retrieval, and execute grounded RAG locally.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open WebRAG Studio"
  }
}
