{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Block",
  "type": "object",
  "required": [
    "id",
    "type",
    "content",
    "headingPath",
    "sourceAnchor",
    "contentHash",
    "included"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique block ID (blk_...)"
    },
    "type": {
      "type": "string",
      "enum": ["heading", "paragraph", "list", "code", "table", "callout"],
      "description": "Semantic type of block"
    },
    "content": {
      "type": "string",
      "description": "Extracted text or markdown content of block"
    },
    "headingPath": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Hierarchy of parent headings leading to this block"
    },
    "sourceAnchor": {
      "type": "object",
      "required": ["blockId", "headingPath", "cssSelector", "textQuote"],
      "properties": {
        "blockId": { "type": "string" },
        "headingPath": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cssSelector": { "type": "string" },
        "textQuote": {
          "type": "object",
          "required": ["exact"],
          "properties": {
            "exact": { "type": "string" },
            "prefix": { "type": "string" },
            "suffix": { "type": "string" }
          },
          "additionalProperties": false
        },
        "nodePath": { "type": "string" }
      },
      "additionalProperties": false,
      "description": "Anchor information for source highlighting"
    },
    "contentHash": {
      "type": "string",
      "description": "SHA-256 content hash"
    },
    "included": {
      "type": "boolean",
      "description": "Whether block is included in downstream chunking/embedding"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "headingLevel": { "type": "integer", "minimum": 1, "maximum": 6 },
        "listKind": { "type": "string", "enum": ["ordered", "unordered"] },
        "codeLanguage": { "type": "string" },
        "tableHeaders": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tableRows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "calloutKind": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
