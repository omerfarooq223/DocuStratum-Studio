{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Capture",
  "type": "object",
  "required": [
    "id",
    "url",
    "title",
    "mode",
    "timestamp",
    "extractorVersion",
    "contentHash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique capture identifier (uuid or content-based hash)"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Page source URL"
    },
    "canonicalUrl": {
      "type": "string",
      "format": "uri",
      "description": "Canonical URL of page if present"
    },
    "title": {
      "type": "string",
      "description": "Web page title"
    },
    "mode": {
      "type": "string",
      "enum": ["selection", "element", "page"],
      "description": "DOM capture mode"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of capture"
    },
    "extractorVersion": {
      "type": "string",
      "description": "Version of DOM extractor engine"
    },
    "contentHash": {
      "type": "string",
      "description": "SHA-256 hash of extracted block contents"
    }
  }
}
