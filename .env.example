# DocuStratum Studio - Companion Service Environment Configuration

# 1. Gemini LLM API Configuration (Recommended)
# Acquire an API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Groq LLM API Configuration (Alternative)
# Sign up and acquire an API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Groq / OpenAI-compatible endpoint URL
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Request timeout in seconds
GROQ_TIMEOUT_SECONDS=30.0

# 2. Local Service Configuration
PORT=8000
HOST=127.0.0.1
