# DocuStratum Studio - Companion Service Environment Configuration

# 1. Groq LLM API Configuration (Optional - Retrieval & Export work 100% locally without this)
# Sign up and acquire a free-tier API key at: https://console.groq.com/keys
GROQ_API_KEY=

# Default Groq model (supports llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
GROQ_MODEL=llama-3.3-70b-versatile

# Groq / OpenAI-compatible endpoint URL
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Request timeout in seconds
GROQ_TIMEOUT_SECONDS=30.0

# 2. Local Service Configuration
PORT=8000
HOST=127.0.0.1
